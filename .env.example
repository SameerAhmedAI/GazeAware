# GazeAware — Environment Variables Template
# Copy this file to .env and fill in your values.

# Anthropic Claude API Key (used by ClaudeEngine — optional)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Groq API Key (required for Phase 2 NLP prescription engine)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq NLP engine toggle (default: true)
# Set to false to fall back to the Phase 1 hardcoded prescription rules (offline mode).
GAZEAWARE_USE_GROQ=true

# Optional: Override webcam index (default: 0)
# WEBCAM_INDEX=0

# Optional: Flask server port (default: 5050)
# FLASK_PORT=5050
